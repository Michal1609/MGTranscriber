# Text files are stored with LF in the repository and checked out with LF on every OS,
# except Windows scripts, which cmd.exe and Windows PowerShell expect with CRLF.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.docx binary
